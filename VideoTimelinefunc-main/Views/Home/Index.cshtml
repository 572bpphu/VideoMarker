@model IEnumerable<VideoTimelineApp.Models.VideoSession>
@{
    ViewBag.Title = "Phân tích Thao tác Video";
    int initialVideoId = ViewBag.InitialVideoId != null ? (int)ViewBag.InitialVideoId : 0;
}

@section HeaderTabs {
    <div id="main-tabs"></div>
}

<div class="app-tabpanel-container">
    <!-- Tab 1: Phân tích Timeline (Player) -->
    <div id="tab-player-content">
        @Html.Partial("~/Views/Video/_PlayerPartial.cshtml")
    </div>

    <!-- Tab 2: Thư viện Video (Library) -->
    <div id="tab-library-content" style="display:none;">
        @Html.Partial("_LibraryPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        // ── DevExtreme Tabs & Application State ──────────────────────
        window.CURRENT_VIDEO_ID = @initialVideoId;
        window.TIMELINE_ACTIVE = true;

        var tabsInstance = null;

        var tabItems = [
            {
                id: "player",
                text: "Phân tích Timeline",
                icon: "video"
            },
            {
                id: "library",
                text: "Thư viện video",
                icon: "folder",
                badge: "@Model.Count()"
            }
        ];

        function switchTab(idx) {
            if (!tabsInstance) return;
            tabsInstance.option("selectedIndex", idx);

            if (idx === 0) {
                // Tab 1: Player (Phân tích Timeline)
                $("#tab-player-content").show();
                $("#tab-library-content").hide();
                window.TIMELINE_ACTIVE = true;

                setTimeout(function () {
                    if (window.redrawTimeline) window.redrawTimeline();
                }, 80);

                if (window.CURRENT_VIDEO_ID > 0 && window.history && window.history.replaceState) {
                    window.history.replaceState(null, '', '@Url.Action("Index", "Home")?videoId=' + window.CURRENT_VIDEO_ID);
                }
            } else if (idx === 1) {
                // Tab 2: Library (Thư viện video)
                $("#tab-player-content").hide();
                $("#tab-library-content").show();
                window.TIMELINE_ACTIVE = false;

                var v = document.getElementById("video");
                if (v && !v.paused) v.pause();

                if (window.history && window.history.replaceState) {
                    window.history.replaceState(null, '', '@Url.Action("Index", "Home")');
                }
            }
        }

        $(function () {
            // Khởi tạo DevExtreme dxTabs trên Header
            $("#main-tabs").dxTabs({
                dataSource: tabItems,
                selectedIndex: 0, // Mặc định ở trang chủ (Tab 1: Player), không cần chuyển qua thư viện ngay
                onItemClick: function (e) {
                    switchTab(e.itemIndex);
                }
            });

            tabsInstance = $("#main-tabs").dxTabs("instance");

            // Mặc định kích hoạt Tab 1 (Player)
            switchTab(0);

            // Nếu ban đầu có videoId, tự động nạp video vào Player
            if (@initialVideoId > 0) {
                window.appTabs.openVideo(@initialVideoId, null, true);
            }
        });

        // ── Quản lý chuyển đổi Tab toàn cục ─────────────────────────
        window.appTabs = {
            openVideo: function (videoId, videoTitle, isInitial) {
                if (!videoId) return;

                // Nếu đang có thay đổi chưa lưu, cảnh báo người dùng
                if (!isInitial && window.isTimelineDirty && window.isTimelineDirty()) {
                    if (!confirm("Bạn có các thay đổi chưa được lưu vào cơ sở dữ liệu. Bạn có chắc muốn đổi sang video khác?")) {
                        return;
                    }
                }

                // Gọi API lấy thông tin chi tiết video và segments
                fetch('@Url.Action("GetSessionJson", "Video")/' + videoId)
                    .then(function (res) {
                        if (!res.ok) throw new Error("Không thể tải dữ liệu video.");
                        return res.json();
                    })
                    .then(function (data) {
                        if (!data.success || !data.session) {
                            alert(data.message || "Không tìm thấy dữ liệu video.");
                            return;
                        }

                        var s = data.session;
                        window.CURRENT_VIDEO_ID = s.id;

                        // Cập nhật tiêu đề Tab 1 (Player)
                        if (tabsInstance) {
                            var items = tabsInstance.option("dataSource");
                            items[0].text = "Phân tích: " + s.title;
                            tabsInstance.option("dataSource", items);
                            setTimeout(function () {
                                var tab1El = document.querySelector("#main-tabs .dx-tab:first-child");
                                if (tab1El) tab1El.setAttribute("title", s.title);
                            }, 50);
                        }

                        // Nạp dữ liệu vào timeline
                        if (window.loadVideoSession) {
                            window.loadVideoSession(s);
                        }

                        // Chuyển sang Tab 1 (Player)
                        switchTab(0);
                    })
                    .catch(function (err) {
                        alert("Lỗi khi nạp video: " + err.message);
                    });
            },

            switchToLibrary: function () {
                switchTab(1);
            },

            isPlayerActive: function () {
                return tabsInstance && tabsInstance.option("selectedIndex") === 0;
            }
        };

        // ── Script Thư viện: Upload & Lọc danh sách video ───────────
        function onFileChosen(input) {
            if (!input.files.length) return;
            var name = input.files[0].name;
            var chosen = document.getElementById('chosen-name');
            if (chosen) {
                chosen.textContent = '📎 ' + name;
                chosen.style.display = 'block';
            }
            var titleInput = document.getElementById('title');
            if (titleInput && !titleInput.value) {
                titleInput.value = name.replace(/\.[^.]+$/, '');
            }
        }

        // Drag & drop on upload zone
        var dz = document.getElementById('drop-zone');
        if (dz) {
            dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('dz-over'); });
            dz.addEventListener('dragleave', function() { dz.classList.remove('dz-over'); });
            dz.addEventListener('drop', function(e) {
                e.preventDefault(); dz.classList.remove('dz-over');
                var fi = document.getElementById('file');
                if (fi && e.dataTransfer.files.length) {
                    fi.files = e.dataTransfer.files;
                    onFileChosen(fi);
                }
            });
        }

        // Upload AJAX
        var uploadForm = document.getElementById('upload-form');
        if (uploadForm) {
            uploadForm.addEventListener('submit', function(e) {
                var fi = document.getElementById('file');
                if (!fi.files || !fi.files.length) return;

                e.preventDefault();
                var file = fi.files[0];
                var title = document.getElementById('title').value;

                var btn   = document.getElementById('upload-btn');
                var prog  = document.getElementById('upload-progress');
                var fill  = document.getElementById('progress-fill');
                var ptext = document.querySelector('.progress-text');

                btn.disabled = true;
                prog.style.display = 'block';
                fill.style.width = '2%';
                ptext.textContent = 'Đang chuẩn bị lưu video...';

                var formData = new FormData();
                formData.append('file', file);
                formData.append('title', title);

                var xhr = new XMLHttpRequest();
                xhr.open('POST', '@Url.Action("UploadAjax", "Home")', true);

                xhr.upload.onprogress = function(pe) {
                    if (pe.lengthComputable) {
                        var pct = Math.round((pe.loaded / pe.total) * 95);
                        fill.style.width = pct + '%';
                        ptext.textContent = 'Đang ghi video vào máy: ' + pct + '%...';
                    }
                };

                xhr.onload = function() {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        try {
                            var res = JSON.parse(xhr.responseText);
                            if (res.success && res.redirectUrl) {
                                fill.style.width = '100%';
                                ptext.textContent = 'Đã lưu video thành công! Đang chuyển tiếp...';
                                window.location.href = res.redirectUrl;
                            } else {
                                throw new Error(res.message || 'Lỗi khi lưu video!');
                            }
                        } catch (err) {
                            alert('Lỗi: ' + err.message);
                            btn.disabled = false;
                            prog.style.display = 'none';
                        }
                    } else {
                        alert('Lỗi máy chủ HTTP ' + xhr.status);
                        btn.disabled = false;
                        prog.style.display = 'none';
                    }
                };

                xhr.onerror = function() {
                    alert('Lỗi kết nối khi tải video lên máy chủ!');
                    btn.disabled = false;
                    prog.style.display = 'none';
                };

                xhr.send(formData);
            });
        }

        // Lọc, tìm kiếm và sắp xếp Thư viện video
        function onLibrarySearchOrFilter() {
            var searchInput = document.getElementById('lib-search-input');
            var filterSelect = document.getElementById('lib-filter-select');
            var sortSelect = document.getElementById('lib-sort-select');

            var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
            var filter = filterSelect ? filterSelect.value : 'all';
            var sort = sortSelect ? sortSelect.value : 'newest';

            var container = document.getElementById('video-list-rows');
            if (!container) return;
            var rows = Array.from(container.children);
            var visibleCount = 0;

            rows.forEach(function(row) {
                var title = row.getAttribute('data-title') || '';
                var segments = parseInt(row.getAttribute('data-segments') || '0', 10);

                var matchesSearch = !query || title.indexOf(query) !== -1;
                var matchesFilter = true;
                if (filter === 'has-segments') matchesFilter = (segments > 0);
                else if (filter === 'no-segments') matchesFilter = (segments === 0);

                if (matchesSearch && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Sắp xếp
            rows.sort(function(a, b) {
                if (sort === 'newest') {
                    return (parseInt(b.getAttribute('data-date') || '0', 10) - parseInt(a.getAttribute('data-date') || '0', 10));
                } else if (sort === 'oldest') {
                    return (parseInt(a.getAttribute('data-date') || '0', 10) - parseInt(b.getAttribute('data-date') || '0', 10));
                } else if (sort === 'name-asc') {
                    return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
                } else if (sort === 'name-desc') {
                    return (b.getAttribute('data-title') || '').localeCompare(a.getAttribute('data-title') || '');
                } else if (sort === 'duration') {
                    return (parseFloat(b.getAttribute('data-duration') || '0') - parseFloat(a.getAttribute('data-duration') || '0'));
                } else if (sort === 'size') {
                    return (parseFloat(b.getAttribute('data-size') || '0') - parseFloat(a.getAttribute('data-size') || '0'));
                }
                return 0;
            });

            rows.forEach(function(row) { container.appendChild(row); });

            var noRes = document.getElementById('no-results-msg');
            if (noRes) noRes.style.display = (visibleCount === 0) ? 'block' : 'none';
        }

        // Chuyển view List / Grid
        function setLibraryViewMode(mode) {
            var container = document.getElementById('video-list-container');
            var btnList = document.getElementById('btn-view-list');
            var btnGrid = document.getElementById('btn-view-grid');
            if (!container) return;

            if (mode === 'grid') {
                container.classList.add('mode-grid');
                if (btnList) btnList.classList.remove('active');
                if (btnGrid) btnGrid.classList.add('active');
            } else {
                container.classList.remove('mode-grid');
                if (btnGrid) btnGrid.classList.remove('active');
                if (btnList) btnList.classList.add('active');
            }
        }

        function selectVideoRow(row, e) {
            if (e.target.closest('.vl-col-actions') || e.target.closest('.vl-col-thumb')) return;
            document.querySelectorAll('.video-list-row').forEach(function(r) { r.classList.remove('selected'); });
            row.classList.add('selected');
        }

        function toggleRowMenu(btn, e) {
            e.stopPropagation();
            var dropdown = btn.nextElementSibling;
            var isShown = dropdown.classList.contains('show');
            document.querySelectorAll('.vl-dropdown.show').forEach(function(d) { d.classList.remove('show'); });
            if (!isShown) dropdown.classList.add('show');
        }

        function confirmDeleteVideo(id, title) {
            if (confirm('Bạn có chắc chắn muốn xoá video "' + title + '" và tất cả mốc thời gian đã đánh dấu?')) {
                var form = document.getElementById('del-form-' + id);
                if (form) form.submit();
            }
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.vl-col-actions')) {
                document.querySelectorAll('.vl-dropdown.show').forEach(function(d) { d.classList.remove('show'); });
            }
        });

        // Tự động kiểm tra thời lượng video nếu chưa có
        document.addEventListener('DOMContentLoaded', function() {
            var rows = document.querySelectorAll('.video-list-row');
            rows.forEach(function(row) {
                var dur = parseFloat(row.getAttribute('data-duration') || '0');
                if (dur <= 0) {
                    var videoId = row.getAttribute('data-id');
                    var streamUrl = row.getAttribute('data-stream-url');
                    if (videoId && streamUrl) {
                        var tempVideo = document.createElement('video');
                        tempVideo.preload = 'metadata';
                        tempVideo.src = streamUrl;
                        tempVideo.onloadedmetadata = function() {
                            if (tempVideo.duration && tempVideo.duration > 0) {
                                var realDur = tempVideo.duration;
                                row.setAttribute('data-duration', realDur);
                                var durEl = row.querySelector('.vl-col-duration');
                                if (durEl) durEl.textContent = formatDurationJS(realDur);

                                fetch('@Url.Content("~/api/segments/video/")' + videoId + '/duration', {
                                    method: 'PUT',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ duration: realDur })
                                });
                            }
                        };
                    }
                }
            });
        });

        function formatDurationJS(sec) {
            if (!sec || sec <= 0) return "--:--";
            var h = Math.floor(sec / 3600);
            var m = Math.floor((sec % 3600) / 60);
            var s = Math.floor(sec % 60);
            var mm = ('0' + m).slice(-2);
            var ss = ('0' + s).slice(-2);
            return h > 0 ? (h + ':' + mm + ':' + ss) : (mm + ':' + ss);
        }
    </script>
    <script src="~/Scripts/timeline.js?v=@DateTime.Now.Ticks"></script>
}
